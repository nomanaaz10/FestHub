rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'superadmin' || 
        request.auth.token.email == 'nomanaaz10@gmail.com' ||
        request.auth.token.email == 'admin@festhub.com'
      );
    }
    
    function isSubAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() || 
        getUserData().role == 'subadmin'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Allow users to update their basic profile, superadmins can update roles
      allow update: if isUser(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Fests collection
    match /fests/{festId} {
      allow read: if true;
      allow create, update, delete: if isSubAdmin();
    }

    // Competitions collection
    match /competitions/{competitionId} {
      allow read: if true;
      allow create, update, delete: if isSubAdmin();
    }

    // Registrations collection
    match /registrations/{regId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSubAdmin());
    }

    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSubAdmin());
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSubAdmin());
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isSubAdmin();
    }

    // Webinars collection
    match /webinars/{webinarId} {
      allow read: if true;
      allow create, update, delete: if isSubAdmin();
    }
  }
}
